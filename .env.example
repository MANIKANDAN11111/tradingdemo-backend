# Groww Trading API credentials
# Get these from https://groww.in/trade-api/api-keys
GROWW_API_KEY="your_api_key_here"
GROWW_API_SECRET="your_api_secret_here"

# Optional: TOTP secret for unattended token refresh (key_type=totp flow)
# GROWW_TOTP_SECRET=""

# CoinSwitch PRO API secret (32-byte hex Ed25519 private seed)
COINSWITCH_SECRET=""
COINSWITCH_BASE_URL="https://coinswitch.co"

# Session signing secret for the login gate — set a stable random 64-char hex
AUTH_SECRET=""

# PostgreSQL connection for the user store (private cluster on 5433 — see server/scripts/setup-local-pg.sh)
DATABASE_URL="postgres://tradingdemo:tradingdemo_pass@127.0.0.1:5433/tradingdemo"

# Password for the seeded "admin" account, created only when the users table is empty
ADMIN_PASSWORD="admin123"

# Server
PORT=5000
